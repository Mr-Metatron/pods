using Gtk 4.0;

template $PdsTextSearchEntry: Widget {
  Image image {
    icon-name: "edit-find-symbolic";
    accessible-role: presentation;
  }

  Text text {
    notify => $on_text_notify() swapped;
    input-hints: no_spellcheck;
    max-width-chars: 32;
    width-chars: 4;
  }

  Label info_label {
    styles [
      "dim-label",
      "numeric",
    ]

    label: bind template.info bidirectional;
    ellipsize: end;
    max-width-chars: 12;
    tooltip-text: bind template.info;
    xalign: 1;
  }

  Box options_box {
    styles [
      "linked",
    ]

    ToggleButton {
      active: bind template.regex bidirectional;
      icon-name: "regex-symbolic";
      tooltip-text: _("Regular Expression");
      valign: center;

      accessibility {
        label: _("Regular Expression");
      }
    }

    ToggleButton {
      active: bind template.case-sensitive bidirectional;
      icon-name: "uppercase-symbolic";
      tooltip-text: _("Case Sensitive");
      valign: center;

      accessibility {
        label: _("Case Sensitive");
      }
    }

    ToggleButton {
      active: bind template.whole-word bidirectional;
      icon-name: "whole-word-symbolic";
      tooltip-text: _("Whole Word");
      valign: center;

      accessibility {
        label: _("Whole Word");
      }
    }
  }

  MenuButton options_button {
    icon-name: "view-more-symbolic";
    tooltip-text: _("Search Options");
    valign: center;
    visible: false;

    accessibility {
      label: _("Search Options");
    }

    popover: Popover {
      Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        CheckButton {
          active: bind template.regex bidirectional;
          label: _("Regular Expression");
        }

        CheckButton {
          active: bind template.case-sensitive bidirectional;
          label: _("Case Sensitive");
        }

        CheckButton {
          active: bind template.whole-word bidirectional;
          label: _("Whole Word");
        }
      }
    };
  }
}
